{
    "python.linting.pylintEnabled": true,
    "python.linting.pycodestyleEnabled": false,
    "python.linting.enabled": true,
    "python.linting.pylintArgs": [
        "--max-line-length=80",
        "--disable=E0401,django-not-configured,no-name-in-module",
        "--load-plugins=pylint_django"
    ],
    "python.pythonPath": "~/.virtualenvs/django-backend/bin/python",
    "python.linting.pycodestyleArgs": ["--max-line-length=80"],
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "prettier.tabWidth": 4,
    "prettier.useTabs": false,
    "files.trimTrailingWhitespace": true,
    "editor.rulers": [80],
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": true
    },
    // "editor.defaultFormatter": "esbenp.prettier-vscode",
    // "[python]": {
    //     "editor.defaultFormatter": "ms-python.python"
    // },
    "python.sortImports.args": ["--src=${workspaceFolder}"],
    // "python.autoComplete.extraPaths": ["${workspaceFolder}"],
    // "python.formatting.autopep8Args": ["--max-line-length", "80"]
}
